
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.email.lower();
    }

    function isMasterAdmin() {
      return isAuthenticated() && getUserEmail() == 'gwdmpm@gmail.com';
    }

    // Role-based lookup helper with existence and approval check
    function getUserData() {
      let email = getUserEmail();
      let userPath = /databases/$(database)/documents/users/$(email);
      return get(userPath).data;
    }

    function hasRole(role) {
      let email = getUserEmail();
      let userPath = /databases/$(database)/documents/users/$(email);
      return isAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.role == role && 
             get(userPath).data.isApproved == true;
    }

    function isApprovedTechnicalStaff() {
      let email = getUserEmail();
      let userPath = /databases/$(database)/documents/users/$(email);
      return isAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.isApproved == true &&
             (get(userPath).data.role == 'admin' || get(userPath).data.role == 'engineer' || get(userPath).data.role == 'scientist');
    }

    function isAdmin() {
      return isMasterAdmin() || hasRole('admin');
    }

    function isScientist() {
      return hasRole('scientist');
    }

    function isEngineer() {
      return hasRole('engineer');
    }

    // --- COLLECTION RULES ---

    // 1. Global Application Settings: Shared read, Admin modify.
    match /appSettings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. District Employees: Centralized roster. Everyone can view, Admin modifies.
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Attendance Logs: Centralized logs. Admin/Technical staff can modify.
    match /attendance_logs/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isApprovedTechnicalStaff();
    }

    // 4. Technical Reports Hub: Unified permissions for all approved technical roles
    match /groundwaterReports/{reportId} {
      allow read: if isAuthenticated();
      
      // Allow any approved technical staff (Admin, Engineer, Scientist) to manage records
      // This supports overlapping duties in the district office
      allow create: if isApprovedTechnicalStaff() || isAdmin();
      allow update: if isApprovedTechnicalStaff() || isAdmin();
      
      // Strict deletion remains with Admin only
      allow delete: if isAdmin();
    }

    // 5. User Profiles: Centralized profiles indexed by email.
    match /users/{userEmail} {
      // allow get for unauthenticated to check registration status during login
      allow get: if true; 
      allow list: if isAuthenticated();
      // Only admins or the owner can update the profile
      allow create: if isAdmin() || (isAuthenticated() && getUserEmail() == userEmail.lower());
      allow update: if isAdmin() || (isAuthenticated() && getUserEmail() == userEmail.lower());
      allow delete: if isAdmin();
    }
  }
}
