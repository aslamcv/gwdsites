rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.email.lower();
    }

    function isMasterAdmin() {
      return isAuthenticated() && getUserEmail() == 'gwdmpm@gmail.com';
    }

    function getUserDoc() {
      let email = getUserEmail();
      return get(/databases/$(database)/documents/users/$(email)).data;
    }

    function isAdmin() {
      return isMasterAdmin() || (isAuthenticated() && getUserDoc().get('role', '').lower() == 'admin');
    }

    function isEngineer() {
      return isAuthenticated() && getUserDoc().get('role', '').lower() == 'engineer';
    }

    function isScientist() {
      return isAuthenticated() && getUserDoc().get('role', '').lower() == 'scientist';
    }

    function isApproved() {
      return isMasterAdmin() || (isAuthenticated() && getUserDoc().get('isApproved', false) != false);
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.uid == resource.data.get('uploadedBy', '') || 
        getUserEmail() == resource.data.get('uploadedBy', '')
      );
    }

    // --- COLLECTION RULES ---

    match /groundwaterReports/{reportId} {
      
      allow read: if isAdmin() || (isApproved() && (isScientist() || isEngineer()));
      
      allow create: if isApproved() && (
        isAdmin() || 
        (isScientist() && (
          'investigation' in request.resource.data.category.lower() || 
          'investigation' in request.resource.data.purpose.lower() ||
          'geological' in request.resource.data.category.lower() || 
          'geological' in request.resource.data.purpose.lower() ||
          'geophysical' in request.resource.data.category.lower() || 
          'geophysical' in request.resource.data.purpose.lower() ||
          'pumping' in request.resource.data.category.lower() ||
          'pumping' in request.resource.data.purpose.lower() ||
          'complaint' in request.resource.data.category.lower() || 
          'complaint' in request.resource.data.purpose.lower() ||
          'nhp' in request.resource.data.category.lower() || 
          'nhp' in request.resource.data.purpose.lower()
        )) ||
        (isEngineer() && (
          'drilling' in request.resource.data.category.lower() ||
          request.resource.data.get('workType', '') == 'DRILLING' ||
          request.resource.data.get('workType', '') == 'FLUSHING' ||
          'supervision' in request.resource.data.category.lower() ||
          'supervision' in request.resource.data.purpose.lower() ||
          'estimate' in request.resource.data.category.lower() ||
          'estimate' in request.resource.data.purpose.lower() ||
          'pumping' in request.resource.data.category.lower() ||
          'pumping' in request.resource.data.purpose.lower() ||
          'measurement' in request.resource.data.category.lower() ||
          'measurement' in request.resource.data.purpose.lower()
        ))
      );
      
      allow update, delete: if isAdmin() || isOwner();
    }

    match /appSettings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /attendance_logs/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isApproved();
    }

    match /users/{userEmail} {
      allow get: if true; 
      allow list: if isAuthenticated();
      allow create, update: if isAdmin() || (isAuthenticated() && getUserEmail() == userEmail.lower());
      allow delete: if isAdmin();
    }
  }
}