
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserEmail() {
      return request.auth.token.email.lower();
    }

    function isMasterAdmin() {
      return isAuthenticated() && getUserEmail() == 'gwdmpm@gmail.com';
    }

    // Check if the user document exists and is approved by the Master Admin
    function isApproved() {
      let email = getUserEmail();
      let userPath = /databases/$(database)/documents/users/$(email);
      return isAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.isApproved == true;
    }

    function isAdmin() {
      let email = getUserEmail();
      let userPath = /databases/$(database)/documents/users/$(email);
      return isMasterAdmin() || (exists(userPath) && get(userPath).data.role == 'admin');
    }

    // --- COLLECTION RULES ---

    // 1. Global Application Settings: Shared read, Admin modify.
    match /appSettings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. District Employees: Centralized roster. Everyone can view, Admin modifies.
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Attendance Logs: Centralized logs. Admin/Technical staff can modify.
    match /attendance_logs/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isApproved() || isAdmin();
    }

    // 4. Technical Reports Hub: Unified permissions for all approved technical roles
    match /groundwaterReports/{reportId} {
      allow read: if isAuthenticated();
      
      // Allow any approved staff member to create records
      allow create: if isApproved() || isAdmin();
      
      // Allow updates if:
      // 1. The user is the original uploader (Owner) - Check UID and Email fallbacks
      // 2. The user is an approved technical staff member
      // 3. The user is a System Administrator
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.uploadedBy || 
        getUserEmail() == resource.data.uploadedBy ||
        isApproved() || 
        isAdmin()
      );
      
      // Allow deletion if the user is:
      // 1. A System Administrator
      // 2. An approved technical staff member
      // 3. The original owner of the record (checking both UID and Email for robustness)
      allow delete: if isAdmin() || isApproved() || (isAuthenticated() && (request.auth.uid == resource.data.uploadedBy || getUserEmail() == resource.data.uploadedBy));
    }

    // 5. User Profiles: Centralized profiles indexed by email.
    match /users/{userEmail} {
      // allow get for unauthenticated to check registration status during login
      allow get: if true; 
      allow list: if isAuthenticated();
      // Only admins or the owner can update the profile
      allow create: if isAdmin() || (isAuthenticated() && getUserEmail() == userEmail.lower());
      allow update: if isAdmin() || (isAuthenticated() && getUserEmail() == userEmail.lower());
      allow delete: if isAdmin();
    }
  }
}
